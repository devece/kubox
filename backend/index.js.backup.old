const express = require('express');
const sqlite3 = require('sqlite3').verbose();
const cors = require('cors');
const bcrypt = require('bcryptjs');
const multer = require('multer');
const path = require('path');
const fs = require('fs');
require('dotenv').config();
const nodemailer = require('nodemailer');

const app = express();
app.use(cors());
app.use(express.json());

const db = new sqlite3.Database('./kubox.db');

// ==================================================
// CONFIGURACIÓN DE EMAIL
// ==================================================
let emailTransporter = nodemailer.createTransport({
  service: 'gmail',
  auth: {
    user: process.env.EMAIL_USER || '',
    pass: process.env.EMAIL_PASS || ''
  }
});

emailTransporter.verify((error, success) => {
  if (error) {
    console.log('⚠️ Email no configurado:', error.message);
  } else {
    console.log('✅ Email configurado correctamente');
  }
});

// ==================================================
// FUNCIONES DE NOTIFICACIÓN POR EMAIL
// ==================================================

async function enviarNotificacionCobro(residente, gasto, periodo, fecha_vencimiento) {
  if (!residente.email) return;
  if (!process.env.EMAIL_USER) return;
  
  const mailOptions = {
    from: `"Kubox" <${process.env.EMAIL_USER}>`,
    to: residente.email,
    subject: `📋 Nuevo gasto común - Periodo ${periodo}`,
    html: `
      <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
        <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px; text-align: center;">
          <h1 style="margin: 0;">Kubox</h1>
          <p style="margin: 5px 0 0;">Gestión de Condominios</p>
        </div>
        <div style="padding: 20px; background: #f9fafb;">
          <h2>Nuevo gasto común generado</h2>
          <p>Estimado/a <strong>${residente.nombre}</strong>,</p>
          <p>Se ha generado el gasto común correspondiente al periodo <strong>${periodo}</strong>.</p>
          <div style="background: white; padding: 15px; border-radius: 8px; margin: 15px 0;">
            <p><strong>🏢 Unidad:</strong> ${residente.unidad_numero}</p>
            <p><strong>💰 Monto a pagar:</strong> <span style="font-size: 20px; color: #2563eb;">$${gasto.monto_total.toLocaleString()}</span></p>
            <p><strong>📅 Fecha de vencimiento:</strong> ${fecha_vencimiento}</p>
          </div>
          <p style="color: #dc2626;">⚠️ Por favor, realiza el pago antes de la fecha de vencimiento.</p>
          <hr>
          <p style="font-size: 12px; color: #6b7280;">Este es un mensaje automático, por favor no responder.</p>
        </div>
      </div>
    `
  };

  try {
    await emailTransporter.sendMail(mailOptions);
    console.log(`📧 Email enviado a ${residente.email}`);
  } catch (error) {
    console.error(`❌ Error enviando email a ${residente.email}:`, error.message);
  }
}

async function enviarNotificacionPago(residente, gasto, periodo) {
  if (!residente.email) return;
  if (!process.env.EMAIL_USER) return;
  
  const mailOptions = {
    from: `"Kubox" <${process.env.EMAIL_USER}>`,
    to: residente.email,
    subject: `✅ Pago registrado - Periodo ${periodo}`,
    html: `
      <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
        <div style="background: linear-gradient(135deg, #16a34a 0%, #15803d 100%); color: white; padding: 20px; text-align: center;">
          <h1 style="margin: 0;">Kubox</h1>
          <p style="margin: 5px 0 0;">Pago Confirmado</p>
        </div>
        <div style="padding: 20px; background: #f9fafb;">
          <h2>¡Pago registrado exitosamente!</h2>
          <p>Estimado/a <strong>${residente.nombre}</strong>,</p>
          <p>Se ha registrado el pago de su gasto común del periodo <strong>${periodo}</strong>.</p>
          <div style="background: #f0fdf4; padding: 15px; border-radius: 8px; margin: 15px 0;">
            <p><strong>🏢 Unidad:</strong> ${residente.unidad_numero}</p>
            <p><strong>💰 Monto pagado:</strong> <span style="font-size: 20px; color: #16a34a;">$${gasto.monto_total.toLocaleString()}</span></p>
          </div>
          <p>¡Gracias por mantener tu cuenta al día!</p>
          <hr>
          <p style="font-size: 12px; color: #6b7280;">Este es un mensaje automático, por favor no responder.</p>
        </div>
      </div>
    `
  };

  try {
    await emailTransporter.sendMail(mailOptions);
    console.log(`📧 Email de pago enviado a ${residente.email}`);
  } catch (error) {
    console.error(`❌ Error enviando email a ${residente.email}:`, error.message);
  }
}

async function enviarComunicadoEmail(destinatario, comunicado) {
  if (!destinatario.email) return;
  if (!process.env.EMAIL_USER) return;
  
  const mailOptions = {
    from: `"Kubox - ${comunicado.autor_rol === 'admin' ? 'Administración' : 'Comité'}" <${process.env.EMAIL_USER}>`,
    to: destinatario.email,
    subject: `📢 Nuevo comunicado: ${comunicado.titulo}`,
    html: `
      <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
        <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px; text-align: center;">
          <h1 style="margin: 0;">Kubox</h1>
          <p style="margin: 5px 0 0;">Nuevo Comunicado</p>
        </div>
        <div style="padding: 20px; background: #f9fafb;">
          <h2>${comunicado.titulo}</h2>
          <div style="background: white; padding: 15px; border-radius: 8px; margin: 15px 0;">
            ${comunicado.contenido}
          </div>
          <hr>
          <p style="font-size: 12px; color: #6b7280;">Este es un mensaje automático de Kubox</p>
        </div>
      </div>
    `
  };

  try {
    await emailTransporter.sendMail(mailOptions);
    console.log(`📧 Comunicado enviado a ${destinatario.email}`);
  } catch (error) {
    console.error(`❌ Error enviando comunicado a ${destinatario.email}:`, error.message);
  }
}

// ==================================================
// CREAR TABLAS
// ==================================================
db.serialize(() => {
  // Usuarios
  db.run(`CREATE TABLE IF NOT EXISTS usuarios (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    email TEXT UNIQUE,
    password TEXT,
    rol TEXT DEFAULT 'residente'
  )`);
  
  // Condominios
  db.run(`CREATE TABLE IF NOT EXISTS condominios (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nombre TEXT,
    creado_en DATETIME DEFAULT CURRENT_TIMESTAMP
  )`);
  
  // Unidades
  db.run(`CREATE TABLE IF NOT EXISTS unidades (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    condominio_id INTEGER,
    numero TEXT,
    torre TEXT,
    tipo TEXT DEFAULT 'depto',
    metros_cuadrados INTEGER,
    estacionamiento INTEGER DEFAULT 0,
    bodega INTEGER DEFAULT 0,
    residente_id INTEGER,
    FOREIGN KEY(condominio_id) REFERENCES condominios(id),
    FOREIGN KEY(residente_id) REFERENCES residentes(id)
  )`);
  
  // Residentes
  db.run(`CREATE TABLE IF NOT EXISTS residentes (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nombre TEXT,
    email TEXT UNIQUE,
    telefono TEXT,
    condominio_id INTEGER
  )`);
  
  // Configuración de gastos
  db.run(`CREATE TABLE IF NOT EXISTS config_gastos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    condominio_id INTEGER UNIQUE,
    valor_metro_cuadrado INTEGER DEFAULT 500,
    porcentaje_fondo_reserva INTEGER DEFAULT 5,
    interes_mora_mensual INTEGER DEFAULT 2,
    dias_gracia INTEGER DEFAULT 5,
    moneda TEXT DEFAULT 'CLP'
  )`);
  
  // Gastos comunes
  db.run(`CREATE TABLE IF NOT EXISTS gastos_comunes (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    condominio_id INTEGER,
    periodo TEXT,
    fecha_emision DATE,
    fecha_vencimiento DATE,
    monto_total INTEGER,
    pagado BOOLEAN DEFAULT 0,
    fecha_pago DATE,
    interes_mora INTEGER DEFAULT 0,
    FOREIGN KEY(condominio_id) REFERENCES condominios(id)
  )`);
  
  // Detalle de gasto por unidad
  db.run(`CREATE TABLE IF NOT EXISTS gastos_unidad (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    gasto_comun_id INTEGER,
    unidad_id INTEGER,
    residente_id INTEGER,
    monto_base INTEGER,
    fondo_reserva INTEGER,
    monto_total INTEGER,
    pagado BOOLEAN DEFAULT 0,
    fecha_pago DATE,
    interes_mora INTEGER DEFAULT 0,
    FOREIGN KEY(gasto_comun_id) REFERENCES gastos_comunes(id),
    FOREIGN KEY(unidad_id) REFERENCES unidades(id),
    FOREIGN KEY(residente_id) REFERENCES residentes(id)
  )`);
  
  // Categorías de gastos
  db.run(`CREATE TABLE IF NOT EXISTS categorias_gastos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nombre TEXT UNIQUE,
    descripcion TEXT
  )`);
  
  // Gastos reales
  db.run(`CREATE TABLE IF NOT EXISTS gastos_reales (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    condominio_id INTEGER,
    categoria_id INTEGER,
    descripcion TEXT,
    monto INTEGER,
    fecha DATE,
    periodo TEXT,
    comprobante TEXT,
    FOREIGN KEY(categoria_id) REFERENCES categorias_gastos(id)
  )`);
  
  // Comunicados
  db.run(`CREATE TABLE IF NOT EXISTS comunicados (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    titulo TEXT,
    contenido TEXT,
    autor TEXT,
    autor_rol TEXT,
    destinatarios TEXT,
    fecha DATETIME DEFAULT CURRENT_TIMESTAMP,
    adjunto_url TEXT,
    adjunto_nombre TEXT
  )`);
  
  // Espacios
  db.run(`CREATE TABLE IF NOT EXISTS espacios (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    condominio_id INTEGER DEFAULT 1,
    nombre TEXT NOT NULL,
    descripcion TEXT,
    capacidad INTEGER DEFAULT 0,
    tiene_costo INTEGER DEFAULT 0,
    costo_por_jornada INTEGER DEFAULT 0,
    monto_garantia INTEGER DEFAULT 0,
    horario_semana_inicio TEXT DEFAULT '11:00',
    horario_semana_fin TEXT DEFAULT '22:00',
    horario_fin_semana_inicio TEXT DEFAULT '11:00',
    horario_fin_semana_fin TEXT DEFAULT '02:00',
    activo INTEGER DEFAULT 1
  )`);
  
  // Reservas
  db.run(`CREATE TABLE IF NOT EXISTS reservas (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    espacio_id INTEGER,
    residente_id INTEGER,
    unidad_id INTEGER,
    fecha DATE,
    hora_inicio TEXT,
    hora_fin TEXT,
    estado TEXT DEFAULT 'pendiente',
    monto_total INTEGER DEFAULT 0,
    pagado INTEGER DEFAULT 0,
    comentario TEXT,
    fecha_reserva DATETIME DEFAULT CURRENT_TIMESTAMP
  )`);
  
  // Bitácora
  db.run(`CREATE TABLE IF NOT EXISTS bitacora (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    fecha DATETIME DEFAULT CURRENT_TIMESTAMP,
    tipo TEXT CHECK(tipo IN ('info', 'alerta', 'incidencia')),
    descripcion TEXT NOT NULL,
    conserje_id INTEGER
  )`);
  
  // Encomiendas
  db.run(`CREATE TABLE IF NOT EXISTS encomiendas (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    fecha_ingreso DATETIME DEFAULT CURRENT_TIMESTAMP,
    residente_id INTEGER,
    unidad_id INTEGER,
    remitente TEXT,
    descripcion TEXT,
    estado TEXT DEFAULT 'pendiente',
    fecha_retiro DATETIME
  )`);
  
  // Visitas
  db.run(`CREATE TABLE IF NOT EXISTS visitas (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    fecha_entrada DATETIME DEFAULT CURRENT_TIMESTAMP,
    fecha_salida DATETIME,
    visitante_nombre TEXT NOT NULL,
    visitante_rut TEXT,
    visitante_telefono TEXT,
    motivo TEXT,
    unidad_destino_id INTEGER,
    placa_vehiculo TEXT,
    estado TEXT DEFAULT 'activa'
  )`);
  
  // Insertar categorías por defecto
  db.run(`INSERT OR IGNORE INTO categorias_gastos (id, nombre) VALUES (1, 'Personal (Sueldos)')`);
  db.run(`INSERT OR IGNORE INTO categorias_gastos (id, nombre) VALUES (2, 'Luz eléctrica')`);
  db.run(`INSERT OR IGNORE INTO categorias_gastos (id, nombre) VALUES (3, 'Agua potable')`);
  db.run(`INSERT OR IGNORE INTO categorias_gastos (id, nombre) VALUES (4, 'Mantención ascensores')`);
  db.run(`INSERT OR IGNORE INTO categorias_gastos (id, nombre) VALUES (5, 'Limpieza y aseo')`);
  db.run(`INSERT OR IGNORE INTO categorias_gastos (id, nombre) VALUES (6, 'Mantención áreas comunes')`);
  db.run(`INSERT OR IGNORE INTO categorias_gastos (id, nombre) VALUES (7, 'Seguridad')`);
  db.run(`INSERT OR IGNORE INTO categorias_gastos (id, nombre) VALUES (8, 'Otros')`);
  
  // Insertar config por defecto
  db.get(`SELECT * FROM config_gastos WHERE condominio_id = 1`, (err, row) => {
    if (!row) {
      db.run(`INSERT INTO config_gastos (condominio_id, valor_metro_cuadrado, porcentaje_fondo_reserva, interes_mora_mensual, dias_gracia) 
              VALUES (1, 500, 5, 2, 5)`);
    }
  });
  
  // Insertar usuario admin
  const hashedPassword = bcrypt.hashSync('admin123', 10);
  db.run(`INSERT OR IGNORE INTO usuarios (id, email, password, rol) VALUES (1, 'admin@kubox.com', ?, 'admin')`, [hashedPassword]);
  
  // Insertar condominio demo
  db.run(`INSERT OR IGNORE INTO condominios (id, nombre) VALUES (1, 'Kubox Central')`);
});

// ==================================================
// LOGIN
// ==================================================
app.post('/api/login', (req, res) => {
  const { email, password } = req.body;
  db.get(`SELECT * FROM usuarios WHERE email = ?`, [email], (err, user) => {
    if (err || !user) return res.status(401).json({ error: 'Usuario no existe' });
    if (bcrypt.compareSync(password, user.password)) {
      res.json({ id: user.id, email: user.email, rol: user.rol });
    } else {
      res.status(401).json({ error: 'Contraseña incorrecta' });
    }
  });
});

// ==================================================
// DASHBOARD
// ==================================================
app.get('/api/dashboard', (req, res) => {
  db.get(`SELECT 
    (SELECT COUNT(*) FROM unidades) as total_unidades,
    (SELECT COUNT(*) FROM residentes) as total_residentes,
    (SELECT COUNT(*) FROM unidades WHERE residente_id IS NOT NULL) as ocupadas,
    (SELECT COUNT(*) FROM gastos_unidad WHERE pagado = 0) as morosos`,
    (err, row) => {
      res.json(row || { total_unidades: 0, total_residentes: 0, ocupadas: 0, morosos: 0 });
    });
});

// ==================================================
// CONFIGURACIÓN DE GASTOS
// ==================================================
app.get('/api/config-gastos', (req, res) => {
  db.get(`SELECT * FROM config_gastos WHERE condominio_id = 1`, (err, row) => {
    if (err || !row) {
      res.json({ valor_metro_cuadrado: 500, porcentaje_fondo_reserva: 5, interes_mora_mensual: 2, dias_gracia: 5 });
    } else {
      res.json(row);
    }
  });
});

app.put('/api/config-gastos', (req, res) => {
  const { valor_metro_cuadrado, porcentaje_fondo_reserva, interes_mora_mensual, dias_gracia } = req.body;
  db.run(`UPDATE config_gastos SET 
    valor_metro_cuadrado = ?, 
    porcentaje_fondo_reserva = ?, 
    interes_mora_mensual = ?, 
    dias_gracia = ? 
    WHERE condominio_id = 1`,
    [valor_metro_cuadrado, porcentaje_fondo_reserva, interes_mora_mensual, dias_gracia], 
    function(err) {
      if (err) {
        res.status(500).json({ error: err.message });
      } else {
        res.json({ success: true });
      }
    });
});

// ==================================================
// CATEGORÍAS Y GASTOS REALES
// ==================================================
app.get('/api/categorias-gastos', (req, res) => {
  db.all(`SELECT * FROM categorias_gastos ORDER BY nombre`, (err, rows) => {
    res.json(rows || []);
  });
});

app.get('/api/gastos-reales/:periodo', (req, res) => {
  const { periodo } = req.params;
  db.all(`SELECT gr.*, c.nombre as categoria_nombre
          FROM gastos_reales gr
          JOIN categorias_gastos c ON gr.categoria_id = c.id
          WHERE gr.periodo = ? AND gr.condominio_id = 1
          ORDER BY gr.fecha DESC`, [periodo], (err, rows) => {
    res.json(rows || []);
  });
});

app.get('/api/gastos-reales-desglose/:periodo', (req, res) => {
  const { periodo } = req.params;
  db.all(`SELECT gr.*, c.nombre as categoria_nombre
          FROM gastos_reales gr
          JOIN categorias_gastos c ON gr.categoria_id = c.id
          WHERE gr.periodo = ? AND gr.condominio_id = 1
          ORDER BY gr.categoria_id`, [periodo], (err, rows) => {
    res.json(rows || []);
  });
});

app.post('/api/gastos-reales', (req, res) => {
  const { categoria_id, descripcion, monto, fecha, periodo, comprobante } = req.body;
  db.run(`INSERT INTO gastos_reales (condominio_id, categoria_id, descripcion, monto, fecha, periodo, comprobante)
          VALUES (1, ?, ?, ?, ?, ?, ?)`,
    [categoria_id, descripcion, monto, fecha, periodo, comprobante || null],
    function(err) {
      if (err) {
        res.status(500).json({ error: err.message });
      } else {
        res.json({ id: this.lastID });
      }
    });
});

app.delete('/api/gastos-reales/:id', (req, res) => {
  db.run(`DELETE FROM gastos_reales WHERE id = ?`, [req.params.id], () => {
    res.json({ success: true });
  });
});

// ==================================================
// GENERAR GASTO MENSUAL DESDE GASTOS REALES
// ==================================================
app.post('/api/generar-gasto-desde-reales', (req, res) => {
  const { periodo, fecha_vencimiento } = req.body;
  
  if (!periodo || !fecha_vencimiento) {
    return res.status(400).json({ error: 'Faltan datos' });
  }
  
  db.get(`SELECT SUM(monto) as total FROM gastos_reales 
          WHERE periodo = ? AND condominio_id = 1`, [periodo], (err, result) => {
    
    const totalGastos = result?.total || 0;
    
    if (totalGastos === 0) {
      return res.status(400).json({ error: 'No hay gastos registrados para este periodo' });
    }
    
    db.get(`SELECT * FROM config_gastos WHERE condominio_id = 1`, (err, config) => {
      const fondoReserva = Math.floor(totalGastos * (config?.porcentaje_fondo_reserva || 5) / 100);
      const montoTotal = totalGastos + fondoReserva;
      
      db.all(`SELECT u.*, r.id as residente_id 
              FROM unidades u 
              LEFT JOIN residentes r ON u.residente_id = r.id
              WHERE u.condominio_id = 1`, (err, unidades) => {
        
        if (unidades.length === 0) {
          return res.status(400).json({ error: 'No hay unidades registradas' });
        }
        
        const totalM2 = unidades.reduce((sum, u) => sum + (u.metros_cuadrados || 50), 0);
        const gastosUnidad = [];
        
        for (const u of unidades) {
          const m2 = u.metros_cuadrados || 50;
          const proporcion = m2 / totalM2;
          const montoBase = Math.floor(totalGastos * proporcion);
          const fondoReservaUnidad = Math.floor(fondoReserva * proporcion);
          const montoTotalUnidad = montoBase + fondoReservaUnidad;
          
          gastosUnidad.push({
            unidad_id: u.id,
            residente_id: u.residente_id,
            monto_base: montoBase,
            fondo_reserva: fondoReservaUnidad,
            monto_total: montoTotalUnidad
          });
        }
        
        db.run(`INSERT INTO gastos_comunes (condominio_id, periodo, fecha_emision, fecha_vencimiento, monto_total) 
                VALUES (1, ?, date('now'), ?, ?)`,
          [periodo, fecha_vencimiento, montoTotal], function(err) {
            if (err) {
              return res.status(500).json({ error: err.message });
            }
            
            const gastoComunId = this.lastID;
            let insertados = 0;
            
            for (const gu of gastosUnidad) {
              db.run(`INSERT INTO gastos_unidad (gasto_comun_id, unidad_id, residente_id, monto_base, fondo_reserva, monto_total) 
                      VALUES (?, ?, ?, ?, ?, ?)`,
                [gastoComunId, gu.unidad_id, gu.residente_id, gu.monto_base, gu.fondo_reserva, gu.monto_total],
                () => {
                  insertados++;
                  if (insertados === gastosUnidad.length) {
                    // Enviar notificaciones por email
                    for (const guNotif of gastosUnidad) {
                      if (guNotif.residente_id) {
                        db.get(`SELECT r.*, u.numero as unidad_numero 
                                FROM residentes r 
                                JOIN unidades u ON r.id = u.residente_id 
                                WHERE r.id = ?`, [guNotif.residente_id], (err, residente) => {
                          if (residente && residente.email && residente.email.includes('@')) {
                            enviarNotificacionCobro(residente, guNotif, periodo, fecha_vencimiento);
                          }
                        });
                      }
                    }
                    
                    res.json({ 
                      success: true, 
                      gastoComunId, 
                      total_gastos: totalGastos,
                      fondo_reserva: fondoReserva,
                      monto_total: montoTotal,
                      unidades: unidades.length 
                    });
                  }
                });
            }
          });
      });
    });
  });
});

// ==================================================
// REGISTRAR PAGO DE UNIDAD
// ==================================================
app.post('/api/pagar-gasto', (req, res) => {
  const { gasto_unidad_id, fecha_pago } = req.body;
  
  db.get(`SELECT gu.*, gc.fecha_vencimiento, gc.periodo, c.dias_gracia, c.interes_mora_mensual,
          r.nombre as residente_nombre, r.email as residente_email, u.numero as unidad_numero
          FROM gastos_unidad gu
          JOIN gastos_comunes gc ON gu.gasto_comun_id = gc.id
          JOIN config_gastos c ON c.condominio_id = gc.condominio_id
          JOIN unidades u ON gu.unidad_id = u.id
          LEFT JOIN residentes r ON gu.residente_id = r.id
          WHERE gu.id = ?`, [gasto_unidad_id], (err, gasto) => {
    
    if (err || !gasto) {
      return res.status(404).json({ error: 'Gasto no encontrado' });
    }
    
    let interesMora = 0;
    const fechaVenc = new Date(gasto.fecha_vencimiento);
    const fechaPagoDate = new Date(fecha_pago);
    const diffDays = Math.ceil((fechaPagoDate - fechaVenc) / (1000 * 60 * 60 * 24));
    
    if (diffDays > gasto.dias_gracia) {
      const mesesMora = Math.ceil((diffDays - gasto.dias_gracia) / 30);
      interesMora = Math.floor(gasto.monto_total * (gasto.interes_mora_mensual / 100) * mesesMora);
    }
    
    db.run(`UPDATE gastos_unidad SET pagado = 1, fecha_pago = ?, interes_mora = ? WHERE id = ?`,
      [fecha_pago, interesMora, gasto_unidad_id], function(err) {
        if (err) {
          res.status(500).json({ error: err.message });
        } else {
          if (gasto.residente_email) {
            db.get(`SELECT r.*, u.numero as unidad_numero 
                    FROM residentes r 
                    JOIN unidades u ON r.id = u.residente_id 
                    WHERE r.email = ?`, [gasto.residente_email], (err, residente) => {
              if (residente) {
                enviarNotificacionPago(residente, gasto, gasto.periodo);
              }
            });
          }
          res.json({ success: true, interes_mora_aplicado: interesMora });
        }
      });
  });
});

