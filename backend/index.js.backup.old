app.get('/api/residente/deuda', (req, res) => {
  const { unidad_id } = req.query;
  db.all(`SELECT gu.*, gc.periodo, gc.fecha_vencimiento
          FROM gastos_unidad gu
          JOIN gastos_comunes gc ON gu.gasto_comun_id = gc.id
          WHERE gu.unidad_id = ? AND gu.pagado = 0`, [unidad_id], (err, rows) => {
    const total = rows.reduce((sum, r) => sum + r.monto_total + (r.interes_mora || 0), 0);
    res.json({ deudas: rows || [], total: total || 0 });
  });
});

app.get('/api/residente/perfil', (req, res) => {
  const { email } = req.query;
  db.get(`SELECT r.*, u.id as unidad_id, u.numero as unidad_numero, u.metros_cuadrados
          FROM residentes r
          LEFT JOIN unidades u ON r.id = u.residente_id
          WHERE r.email = ?`, [email], (err, row) => {
    if (err) {
      res.status(500).json({ error: err.message });
    } else if (!row) {
      res.json({ error: 'Residente no encontrado' });
    } else {
      res.json(row);
    }
  });
});

