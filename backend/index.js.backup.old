app.get('/api/comunicados-residente', (req, res) => {
  const { email } = req.query;
  db.get(`SELECT u.id as unidad_id FROM unidades u JOIN residentes r ON u.residente_id = r.id WHERE r.email = ?`, [email], (err, residente) => {
    if (err || !residente) return res.json([]);
    db.all(`SELECT * FROM comunicados 
            WHERE destinatarios LIKE '%todos%'
               OR destinatarios LIKE ? 
            ORDER BY fecha DESC`, [`%${residente.unidad_id}%`], (err, rows) => {
      res.json(rows || []);
    });
  });
});

app.post('/api/comunicados', async (req, res) => {
  const { titulo, contenido, autor, autor_rol, destinatarios, residentes_seleccionados, adjunto_url, adjunto_nombre } = req.body;
  
  db.run(`INSERT INTO comunicados (titulo, contenido, autor, autor_rol, destinatarios, adjunto_url, adjunto_nombre)
          VALUES (?, ?, ?, ?, ?, ?, ?)`,
    [titulo, contenido, autor, autor_rol, JSON.stringify({ tipo: destinatarios, ids: residentes_seleccionados || [] }), adjunto_url || null, adjunto_nombre || null],
    async function(err) {
      if (err) {
        res.status(500).json({ error: err.message });
      } else {
        let destinatariosEmails = [];
        if (destinatarios === 'todos') {
          destinatariosEmails = await new Promise(resolve => db.all(`SELECT email, nombre FROM residentes WHERE email IS NOT NULL AND email != ''`, (err, rows) => resolve(rows || [])));
        } else if (destinatarios === 'morosos') {
          destinatariosEmails = await new Promise(resolve => db.all(`SELECT DISTINCT r.email, r.nombre FROM residentes r JOIN unidades u ON r.id = u.residente_id JOIN gastos_unidad gu ON gu.unidad_id = u.id WHERE gu.pagado = 0 AND r.email IS NOT NULL`, (err, rows) => resolve(rows || [])));
        } else if (residentes_seleccionados && residentes_seleccionados.length > 0) {
          destinatariosEmails = await new Promise(resolve => db.all(`SELECT email, nombre FROM residentes WHERE id IN (${residentes_seleccionados.join(',')}) AND email IS NOT NULL`, (err, rows) => resolve(rows || [])));
        }
        
        for (const dest of destinatariosEmails) {
          if (dest.email && dest.email.includes('@')) {
            enviarComunicadoEmail(dest, { titulo, contenido, autor_rol });
          }
        }
        res.json({ id: this.lastID });
      }
    });
});

app.delete('/api/comunicados/:id', (req, res) => {
