app.get('/api/grafico-ingresos', (req, res) => {
  db.all(`SELECT 
            gc.periodo,
            SUM(gu.monto_total + gu.interes_mora) as total_recaudado,
            (SELECT COUNT(*) FROM gastos_unidad WHERE pagado = 1 AND gasto_comun_id = gc.id) as pagados,
            (SELECT COUNT(*) FROM gastos_unidad WHERE pagado = 0 AND gasto_comun_id = gc.id) as morosos
          FROM gastos_comunes gc
          JOIN gastos_unidad gu ON gc.id = gu.gasto_comun_id
          GROUP BY gc.periodo
          ORDER BY gc.periodo DESC
          LIMIT 6`, (err, rows) => {
    res.json(rows || []);
  });
});

app.get('/api/grafico-gastos-categoria', (req, res) => {
  db.all(`SELECT 
            c.nombre as categoria,
            SUM(gr.monto) as total
          FROM gastos_reales gr
          JOIN categorias_gastos c ON gr.categoria_id = c.id
          WHERE gr.periodo = (
            SELECT periodo FROM gastos_comunes ORDER BY periodo DESC LIMIT 1
          )
          GROUP BY gr.categoria_id
          ORDER BY total DESC
          LIMIT 6`, (err, rows) => {
    res.json(rows || []);
  });
});

app.get('/api/grafico-morosidad', (req, res) => {
  db.all(`SELECT 
            gc.periodo,
            COUNT(CASE WHEN gu.pagado = 0 THEN 1 END) as morosos,
            COUNT(CASE WHEN gu.pagado = 1 THEN 1 END) as pagados,
            COUNT(*) as total
          FROM gastos_comunes gc
          JOIN gastos_unidad gu ON gc.id = gu.gasto_comun_id
          GROUP BY gc.periodo
          ORDER BY gc.periodo DESC
          LIMIT 6`, (err, rows) => {
    res.json(rows || []);
  });
});

app.get('/api/dashboard-stats', (req, res) => {
  db.get(`SELECT 
    (SELECT COUNT(*) FROM unidades) as total_unidades,
    (SELECT COUNT(*) FROM unidades WHERE residente_id IS NOT NULL) as ocupadas,
    (SELECT COUNT(*) FROM residentes) as total_residentes,
    (SELECT COUNT(*) FROM gastos_unidad WHERE pagado = 0) as morosos,
    (SELECT SUM(gu.monto_total + gu.interes_mora) FROM gastos_unidad gu WHERE gu.pagado = 1 AND strftime('%Y-%m', gu.fecha_pago) = strftime('%Y-%m', 'now')) as recaudado_mes,
    (SELECT SUM(gu.monto_total + gu.interes_mora) FROM gastos_unidad gu WHERE gu.pagado = 1) as recaudado_total,
    (SELECT SUM(gu.monto_total + gu.interes_mora) FROM gastos_unidad gu WHERE gu.pagado = 0) as deuda_total
    `, (err, row) => {
    res.json(row || {});
  });
});

