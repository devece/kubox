// ==================================================
// COMUNICADOS (CRUD + Archivos)
// ==================================================

// Crear carpetas para uploads
const uploadsDir = path.join(__dirname, 'uploads');
const imagenesDir = path.join(uploadsDir, 'imagenes');
const adjuntosDir = path.join(uploadsDir, 'adjuntos');

if (!fs.existsSync(imagenesDir)) fs.mkdirSync(imagenesDir, { recursive: true });
if (!fs.existsSync(adjuntosDir)) fs.mkdirSync(adjuntosDir, { recursive: true });

const storageImagen = multer.diskStorage({
  destination: (req, file, cb) => cb(null, imagenesDir),
  filename: (req, file, cb) => cb(null, Date.now() + '-' + Math.round(Math.random() * 1E9) + path.extname(file.originalname))
});

const storageAdjunto = multer.diskStorage({
  destination: (req, file, cb) => cb(null, adjuntosDir),
  filename: (req, file, cb) => cb(null, Date.now() + '-' + Math.round(Math.random() * 1E9) + path.extname(file.originalname))
});

const uploadImagen = multer({ storage: storageImagen, limits: { fileSize: 5 * 1024 * 1024 } });
const uploadAdjunto = multer({ storage: storageAdjunto, limits: { fileSize: 10 * 1024 * 1024 } });

app.use('/uploads', express.static(uploadsDir));

app.get('/api/comunicados', (req, res) => {
