app.get('/api/gastos-comunes', (req, res) => {
    db.all(`SELECT 
                gu.*, 
                u.numero as unidad_numero,
                gc.periodo, 
                gc.concepto, 
                gc.fecha_vencimiento 
            FROM gastos_unidad gu 
            JOIN unidades u ON u.id = gu.unidad_id
            JOIN gastos_comunes gc ON gc.id = gu.gasto_comun_id 
            ORDER BY gc.periodo DESC, u.numero`, 
        (err, rows) => {
            if (err) {
                console.log('Error:', err.message);
                return res.status(500).json({ error: err.message });
            }
            res.json(rows);
        }
    );
});

app.post('/api/generar-cobros', (req, res) => {
    const { periodo, concepto, monto_total, fecha_vencimiento } = req.body;
    
    // 1. Insertar el gasto común principal
    db.run(`INSERT INTO gastos_comunes (condominio_id, periodo, concepto, monto_total, fecha_emision, fecha_vencimiento, pagado) 
            VALUES (1, ?, ?, ?, date('now'), ?, 0)`,
        [periodo, concepto, monto_total, fecha_vencimiento],
        function(err) {
            if (err) {
                console.log('Error insertando gasto_comun:', err.message);
                return res.status(500).json({ error: err.message });
            }
            
            const gastoComunId = this.lastID;
            
            // 2. Obtener todas las unidades
            db.all('SELECT id FROM unidades', (err, unidades) => {
                if (err) {
                    console.log('Error obteniendo unidades:', err.message);
                    return res.status(500).json({ error: err.message });
                }
                
                if (!unidades || unidades.length === 0) {
                    return res.status(400).json({ error: 'No hay unidades registradas' });
                }
                
                let montoPorUnidad = Math.round(monto_total / unidades.length);
                let insertados = 0;
                
                // 3. Insertar el gasto por cada unidad
                unidades.forEach(u => {
                    db.run(`INSERT INTO gastos_unidad 
                            (gasto_comun_id, unidad_id, monto_base, monto_total, pagado) 
                            VALUES (?, ?, ?, ?, 0)`,
                        [gastoComunId, u.id, montoPorUnidad, montoPorUnidad],
                        function(err) {
                            if (err) console.log('Error insertando gasto_unidad:', err.message);
                            insertados++;
                            if (insertados === unidades.length) {
                                res.json({ 
                                    success: true, 
                                    message: `Cobros generados para ${unidades.length} unidades`,
                                    monto_por_unidad: montoPorUnidad
                                });
                            }
                        }
                    );
                });
            });
        }
    );
});

app.post('/api/registrar-pago', (req, res) => {
    const { gasto_comun_id, unidad_id, monto, fecha_pago, metodo_pago } = req.body;
    db.run('INSERT INTO pagos (gasto_comun_id, unidad_id, monto, fecha_pago, metodo_pago) VALUES (?, ?, ?, ?, ?)',
        [gasto_comun_id, unidad_id, monto, fecha_pago, metodo_pago], function(err) {
            if (err) return res.status(500).json({ error: err.message });
            db.run('UPDATE gastos_comunes SET estado = ?, fecha_pago = ? WHERE id = ?',
                ['pagado', fecha_pago, gasto_comun_id]);
            res.json({ success: true });
        });
});

app.get('/api/estadisticas-gastos', (req, res) => {
    // Total de gastos generales
    db.get('SELECT SUM(monto) as total_monto FROM gastos_generales', (err, gastos) => {
        if (err) {
            console.log('Error en gastos_generales:', err.message);
            return res.status(500).json({ error: err.message });
        }
        
        // Gastos pendientes por unidad
        db.get('SELECT COUNT(*) as pendientes, SUM(monto_total) as monto_pendiente FROM gastos_unidad WHERE pagado = 0', (err2, pendientes) => {
            if (err2) {
                console.log('Error en gastos_unidad:', err2.message);
                return res.status(500).json({ error: err2.message });
            }
            
            res.json({ 
                total_gastos: gastos?.total_monto || 0, 
                pendientes: pendientes?.pendientes || 0, 
                monto_pendiente: pendientes?.monto_pendiente || 0 
            });
        });
    });
});
