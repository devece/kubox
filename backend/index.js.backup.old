// ==================================================
// RESERVAS DE ESPACIOS
// ==================================================
function esMoroso(residenteId, callback) {
  db.get(`SELECT COUNT(*) as deuda_meses, SUM(gu.monto_total) as deuda_total
          FROM gastos_unidad gu
          WHERE gu.residente_id = ? AND gu.pagado = 0`, [residenteId], (err, row) => {
    callback(null, (row?.deuda_meses || 0) >= 2 || (row?.deuda_total || 0) > 0);
  });
}

app.get('/api/reservas', (req, res) => {
  const { espacio_id, fecha, unidad_id } = req.query;
  let query = `SELECT r.*, e.nombre as espacio_nombre, e.monto_garantia, e.costo_por_jornada,
               re.nombre as residente_nombre, u.numero as unidad_numero
               FROM reservas r
               JOIN espacios e ON r.espacio_id = e.id
               LEFT JOIN residentes re ON r.residente_id = re.id
               LEFT JOIN unidades u ON r.unidad_id = u.id`;
  let conditions = [];
  let params = [];

  if (espacio_id) {
    conditions.push('r.espacio_id = ?');
    params.push(espacio_id);
  }
  if (fecha) {
    conditions.push('r.fecha = ?');
    params.push(fecha);
  }
  if (unidad_id) {
    conditions.push('r.unidad_id = ?');
    params.push(unidad_id);
  }

  if (conditions.length) query += ' WHERE ' + conditions.join(' AND ');
  query += ' ORDER BY r.fecha DESC, r.hora_inicio ASC';

  db.all(query, params, (err, rows) => {
    res.json(rows || []);
  });
});

app.get('/api/reservas/disponibilidad', (req, res) => {
  const { espacio_id, fecha, hora_inicio, hora_fin } = req.query;
  db.get(`SELECT COUNT(*) as conflictos FROM reservas 
          WHERE espacio_id = ? AND fecha = ? 
          AND estado != 'cancelada'
          AND ((hora_inicio <= ? AND hora_fin > ?) OR (hora_inicio < ? AND hora_fin >= ?) OR (hora_inicio >= ? AND hora_fin <= ?))`,
    [espacio_id, fecha, hora_fin, hora_inicio, hora_fin, hora_inicio, hora_inicio, hora_fin],
    (err, row) => {
      res.json({ disponible: (row?.conflictos || 0) === 0 });
    });
});

app.post('/api/reservas', (req, res) => {
  const { espacio_id, residente_id, unidad_id, fecha, hora_inicio, hora_fin, comentario } = req.body;
  esMoroso(residente_id, (err, moroso) => {
    if (moroso) return res.status(403).json({ error: 'No puedes reservar porque tienes deudas pendientes.' });
    db.get(`SELECT COUNT(*) as conflictos FROM reservas 
            WHERE espacio_id = ? AND fecha = ? AND estado != 'cancelada'
            AND ((hora_inicio <= ? AND hora_fin > ?) OR (hora_inicio < ? AND hora_fin >= ?))`,
      [espacio_id, fecha, hora_fin, hora_inicio, hora_fin, hora_inicio],
      (err, row) => {
        if (row.conflictos > 0) return res.status(409).json({ error: 'El espacio ya está reservado' });
        db.get(`SELECT tiene_costo, costo_por_jornada, monto_garantia FROM espacios WHERE id = ?`, [espacio_id], (err, espacio) => {
          const montoTotal = (espacio?.tiene_costo ? (espacio?.costo_por_jornada || 0) : 0);
          const montoGarantia = espacio?.monto_garantia || 0;
          const totalConGarantia = montoTotal + montoGarantia;
          db.run(`INSERT INTO reservas (espacio_id, residente_id, unidad_id, fecha, hora_inicio, hora_fin, comentario, monto_total)
                  VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
            [espacio_id, residente_id, unidad_id, fecha, hora_inicio, hora_fin, comentario || null, totalConGarantia],
            function(err) {
              if (err) {
                res.status(500).json({ error: err.message });
              } else {
                res.json({ id: this.lastID, monto_total: totalConGarantia, monto_uso: montoTotal, monto_garantia: montoGarantia });
              }
            });
        });
      });
  });
});

